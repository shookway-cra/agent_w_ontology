bs:FFG-62 a owl:Class ; rdfs:subClassOf bs:Frigate ; rdfs:label "Constellation-class frigate" .
bs:BuyanM a owl:Class ; rdfs:subClassOf bs:Corvette ; rdfs:label "Project 21631 Buyan-M corvette" .
bs:Karakurt a owl:Class ; rdfs:subClassOf bs:Corvette ; rdfs:label "Project 22800 Karakurt corvette" .

