bs:SentinelF1 a owl:Class ; rdfs:subClassOf bs:EngagementRadar , bs:SurveillanceRadar ; rdfs:label "AN/MPQ-64F1 Sentinel (NASAMS)" .
bs:NASAMS_FDC a owl:Class ; rdfs:subClassOf bs:AirDefenseCommandPost ; rdfs:label "NASAMS fire distribution center" .
bs:M-SHORAD a owl:Class ; rdfs:subClassOf bs:SHORADSystem ; rdfs:label "M-SHORAD Increment 1 (Stryker)" .
bs:5P85TE2 a owl:Class ; rdfs:subClassOf bs:SAMLauncher ; rdfs:label "5P85TE2 S-400 TEL" .
bs:92N6E a owl:Class ; rdfs:subClassOf bs:EngagementRadar ; rdfs:label "92N6E Grave Stone (S-400 multifunction radar)" .
bs:91N6E a owl:Class ; rdfs:subClassOf bs:SurveillanceRadar ; rdfs:label "91N6E Big Bird (S-400 acquisition radar)" .
bs:55K6E a owl:Class ; rdfs:subClassOf bs:AirDefenseCommandPost ; rdfs:label "55K6E S-400 command post" .
bs:9A317M a owl:Class ; rdfs:subClassOf bs:SAMLauncher ; rdfs:label "9A317M Buk-M3 TELAR" .
bs:9S36M a owl:Class ; rdfs:subClassOf bs:EngagementRadar ; rdfs:label "9S36M Buk-M3 illumination & guidance radar" .
bs:9S18M1 a owl:Class ; rdfs:subClassOf bs:SurveillanceRadar ; rdfs:label "9S18M1 Snow Drift (Buk acquisition radar)" .
bs:9S510M a owl:Class ; rdfs:subClassOf bs:AirDefenseCommandPost ; rdfs:label "9S510M Buk command post" .
bs:PantsirS1 a owl:Class ; rdfs:subClassOf bs:SHORADSystem ; rdfs:label "96K6 Pantsir-S1" .
bs:TorM2 a owl:Class ; rdfs:subClassOf bs:SHORADSystem ; rdfs:label "9K332 Tor-M2" .
bs:NeboM a owl:Class ; rdfs:subClassOf bs:EarlyWarningRadar ; rdfs:label "55Zh6M Nebo-M" .
bs:Baikal a owl:Class ; rdfs:subClassOf bs:AirDefenseCommandPost ; rdfs:label "Baikal-1ME IADS command center" .

# ---- Air defence units: DEFINED classes, membership is inferred -------------
#  A unit's function is not asserted anywhere; the reasoner classifies each unit
#  from the equipment beneath it in the chain of command (bs:hasSubordinate).

bs:SAMBattalion a owl:Class ;
    rdfs:label "SAM battalion" ;
    skos:altLabel "surface-to-air missile battalion" , "air defence battalion" , "SAM unit" ;
    rdfs:comment "A battalion-echelon unit with SAM launchers and/or self-contained SHORAD systems beneath it. Defined class: membership is inferred from equipment. Every SAM battalion is an IntegratedSAMBattalion, a SHORADBattalion, or both." ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( bs:MilitaryUnit
        [ a owl:Restriction ; owl:onProperty bs:echelon ; owl:hasValue bs:Battalion ]
        [ a owl:Restriction ; owl:onProperty bs:hasSubordinate ;
          owl:someValuesFrom [ a owl:Class ; owl:unionOf ( bs:SAMLauncher bs:SHORADSystem ) ] ] ) ] .

bs:IntegratedSAMBattalion a owl:Class ;
    rdfs:label "Integrated SAM battalion (separate launchers, radars and command posts)" ;
    rdfs:comment "SAM battalion built from separate components. Mission-capable only while it has at least one operational bs:SAMLauncher, one operational bs:EngagementRadar and one operational bs:AirDefenseCommandPost beneath it. Defined class: inferred." ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( bs:SAMBattalion
        [ a owl:Restriction ; owl:onProperty bs:hasSubordinate ; owl:someValuesFrom bs:SAMLauncher ] ) ] .

bs:SHORADBattalion a owl:Class ;
    rdfs:label "SHORAD battalion (self-contained fire units)" ;
    rdfs:comment "SAM battalion of self-contained SHORAD vehicles. Mission-capable while any one bs:SHORADSystem beneath it is operational. Defined class: inferred." ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( bs:SAMBattalion
        [ a owl:Restriction ; owl:onProperty bs:hasSubordinate ; owl:someValuesFrom bs:SHORADSystem ] ) ] .

bs:Ship a owl:Class ; rdfs:subClassOf bs:Platform ; rdfs:label "Ship" .
bs:SurfaceCombatant a owl:Class ; rdfs:subClassOf bs:Ship ; rdfs:label "Surface combatant" .
