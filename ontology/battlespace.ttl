bs:AirDefenseElement a owl:Class ; rdfs:subClassOf bs:Platform ;
    rdfs:label "Air defense element" ;
    skos:altLabel "IADS element" , "GBAD" ;
    rdfs:comment "Any component of a ground-based air defense system: launchers, radars, command posts, self-contained SHORAD." .
bs:SAMLauncher a owl:Class ; rdfs:subClassOf bs:AirDefenseElement , bs:GroundVehicle ; rdfs:label "SAM launcher / TEL" .
bs:SHORADSystem a owl:Class ; rdfs:subClassOf bs:AirDefenseElement , bs:GroundVehicle ; rdfs:label "Self-contained SHORAD fire unit" ;
    rdfs:comment "Carries its own radar and missiles: mission-capable on its own." .
bs:AirDefenseRadar a owl:Class ; rdfs:subClassOf bs:AirDefenseElement ; rdfs:label "Air defense radar" .
bs:EngagementRadar a owl:Class ; rdfs:subClassOf bs:AirDefenseRadar ;
    rdfs:label "Engagement / fire-control radar" ;
    skos:altLabel "FCR" , "multifunction radar" ;
    rdfs:comment "Radar that guides interceptors. A SAM battery cannot engage without an operational engagement radar." .
bs:SurveillanceRadar a owl:Class ; rdfs:subClassOf bs:AirDefenseRadar ; rdfs:label "Surveillance / acquisition radar" .
bs:EarlyWarningRadar a owl:Class ; rdfs:subClassOf bs:SurveillanceRadar ; rdfs:label "Long-range early warning radar" .
bs:AirDefenseCommandPost a owl:Class ; rdfs:subClassOf bs:AirDefenseElement ;
    rdfs:label "Air defense command post / fire direction center" ;
    rdfs:comment "Battery or battalion fire direction. A SAM battery cannot engage without an operational command post." .

